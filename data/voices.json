    "hero and Pip wave": "hero and, Pip wave",
    "looked down": "looked, down",
    "first tart": "first, tart",
    "Village,” it said": "Village,” it, said",
    "Puffbun sniffed": "Puffbun, sniffed",
    "Pip sighed": "Pip, sighed",
    "circles stayed": "circles, stayed",
    "person, not a": "person, not, a",
    "hero spliced": "hero, spliced",
    "joined two": "joined, two",
    "quick and": "quick, and",
    "walked the": "walked, the",
    "Returned to": "Returned, to",
    "gardens sparkle": "gardens, sparkle",
    "gardens sparkled": "gardens, sparkled",
    "as sitting": "as, sitting",
    "float had": "float, had",
    "dragon sighed": "dragon, sighed",
    "a brass": "a, brass",
    "anyone who swept": "anyone who, swept",
    "glow-chimes": "glow chimes"
  },
  "sayAsPhonemes": {
    "_doc": "a phrase whose Kokoro phonemes need one sound swapped (no spelling gives it): phrase → [[from, to], …]",
